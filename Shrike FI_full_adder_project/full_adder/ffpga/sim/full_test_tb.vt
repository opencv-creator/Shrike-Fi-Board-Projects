// Custom testbench

`timescale 1ns / 1ps

module full_test_tb;

    reg a;
    reg b;
    reg c_in;

    wire sum;
    wire carry;
    
    wire sum_en;
    wire carry_en;

    // Instantiate the Full Adder
    full_adder uut (
        .a(a),
        .b(b),
        .c_in(c_in),
        .sum(sum),
        .sum_en(sum_en),
        .carry(carry),
        .carry_en(carry_en)
    );

    // Test all possible input combinations
    initial begin
    
    $dumpfile ("full_test_tb.vcd");
    $dumpvars (0, full_test_tb);

        $monitor("Time=%0t | a=%b b=%b c_in=%b | sum=%b carry=%b",
                 $time, a, b, c_in, sum, carry);

        a = 0; b = 0; c_in = 0; #10;
        a = 0; b = 0; c_in = 1; #10;
        a = 0; b = 1; c_in = 0; #10;
        a = 0; b = 1; c_in = 1; #10;
        a = 1; b = 0; c_in = 0; #10;
        a = 1; b = 0; c_in = 1; #10;
        a = 1; b = 1; c_in = 0; #10;
        a = 1; b = 1; c_in = 1; #10;

    $finish;
    end


endmodule


